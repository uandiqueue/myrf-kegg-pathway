legend_box [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
<TR><TD COLSPAN="2" ALIGN="CENTER"><B>Legend</B></TD></TR>
<TR><TD COLSPAN="2" ALIGN="CENTER"><I>Node fills</I></TD></TR>
<TR><TD BGCOLOR="#FFD700">MYRF (core hub)</TD><TD BGCOLOR="#AED6F1">Upstream regulator</TD></TR>
<TR><TD BGCOLOR="#A9DFBF">Downstream target</TD><TD BGCOLOR="#D5DBDB">Candidate / context</TD></TR>
<TR><TD COLSPAN="2" ALIGN="CENTER"><I>Edge subtypes present</I></TD></TR>
<TR><TD COLSPAN="2" ALIGN="LEFT">--&gt; green solid   : protein activation</TD></TR>
<TR><TD COLSPAN="2" ALIGN="LEFT">--&gt; green solid   : transcriptional activation</TD></TR>
<TR><TD COLSPAN="2" ALIGN="LEFT">..&gt; grey dashed   : indirect/signalling effect</TD></TR>
<TR><TD COLSPAN="2" ALIGN="LEFT">--| red solid        : protein inhibition</TD></TR>
<TR><TD COLSPAN="2" ALIGN="LEFT">?   grey dashed      : unknown / needs review</TD></TR>
<TR><TD COLSPAN="2" ALIGN="LEFT">--| red solid        : transcriptional repression</TD></TR>
<TR><TD COLSPAN="2" ALIGN="CENTER"><I>Line width = confidence</I></TD></TR>
<TR><TD>Strong : thick (2.0)</TD><TD>Moderate : medium (1.2)</TD></TR>
<TR><TD COLSPAN="2">Weak : thin (0.8) + dashed</TD></TR>
<TR><TD COLSPAN="2">[ review ] = needs manual review</TD></TR>
</TABLE>>, shape=none, margin=0, fontname="Helvetica", fontsize=9];
